{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": ".",
    "outDir": "dist",
    "typeRoots": ["./types"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
