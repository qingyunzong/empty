{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "oracle/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
