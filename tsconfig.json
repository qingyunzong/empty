{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "/usr/share/nodejs/@types"]
  },
  "include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
