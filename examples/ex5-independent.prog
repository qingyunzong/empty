# SAFE: three fully independent threads; the swap reduction collapses
# all interleavings into a single equivalence class.
var x = 0
var y = 0
var z = 0
thread T1
  write x 1
  read a x
  assert a == 1
end
thread T2
  write y 2
  read b y
  assert b == 2
end
thread T3
  write z 3
  read c z
  assert c == 3
end
