{
  "variables": ["p0", "p1", "p2"],
  "init": {"p0": 0, "p1": 0, "p2": 0},
  "transitions": [
    {"name": "enter0", "guard": "p0 == 0", "assign": {"p0": "1"}},
    {"name": "enter1", "guard": "p1 == 0", "assign": {"p1": "1"}},
    {"name": "enter2", "guard": "p2 == 0", "assign": {"p2": "1"}},
    {"name": "leave0", "guard": "p0 == 1", "assign": {"p0": "0"}},
    {"name": "leave1", "guard": "p1 == 1", "assign": {"p1": "0"}},
    {"name": "leave2", "guard": "p2 == 1", "assign": {"p2": "0"}}
  ],
  "invariant": "p0 + p1 + p2 <= 1"
}
