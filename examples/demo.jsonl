# 合成示例: 两个活跃分区, 水位线 10 与 5, 事件时间 7 的释放过程
{"op": "watermark", "partition": 0, "time": 10}
{"op": "watermark", "partition": 1, "time": 5}
{"op": "event", "partition": 0, "time": 7, "seq": 1, "payload": "order-7"}
{"op": "watermark", "partition": 1, "time": 7}
{"op": "watermark", "partition": 1, "time": 8}
{"op": "event", "partition": 1, "time": 6, "seq": 1, "payload": "too-late"}
{"op": "event", "partition": 1, "time": 9, "seq": 2, "payload": "order-9"}
{"op": "idle", "partition": 1}
{"op": "commit"}
