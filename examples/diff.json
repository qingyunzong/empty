{
  "attributes": {
    "role": ["admin", "user"],
    "mfa": ["on", "off"]
  },
  "policies": {
    "A": {
      "default": "deny",
      "rules": [
        { "when": { "role": "admin" }, "decision": "permit" }
      ]
    },
    "B": {
      "default": "deny",
      "rules": [
        { "when": { "role": "admin", "mfa": "on" }, "decision": "permit" }
      ]
    }
  }
}
