+    def test_zero_weight_tie_prefers_smaller_next_node(self):
+        g = IncrementalGraph()
+        g.set_source("s")
+        g.add_edge("s", "t", 2)
+        g.add_edge("s", "a", 0)
+        g.add_edge("a", "t", 2)
+        # [s, a, t] < [s, t] because "a" < "t" at position 1.
+        self.assertEqual(g.path("t"), ["s", "a", "t"])
