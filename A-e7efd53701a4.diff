+class TestC_LexicographicTieBreak(unittest.TestCase):
+    def test_equal_length_paths_pick_lexicographically_smallest(self):
+        g = IncrementalGraph()
+        g.set_source("s")
+        for u, v, w in [("s", "b", 1), ("s", "a", 1), ("a", "t", 1), ("b", "t", 1)]:
+            g.add_edge(u, v, w)
+        self.assertEqual(g.distance("t"), 2)
