+class TestB_BridgeRemoval(unittest.TestCase):
+    def test_removing_unique_bridge_makes_unreachable(self):
+        g = IncrementalGraph()
+        g.set_source("s")
+        for u, v, w in [("s", "a", 1), ("a", "b", 2), ("b", "c", 3)]:
+            g.add_edge(u, v, w)
+        self.assertEqual(g.distance("c"), 6)
