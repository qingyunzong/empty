+        g.add_edge("c", "t", 2)
+        self.assertEqual(g.path("t"), ["s", "c", "t"])
+        g.add_edge("s", "b", 2)
+        g.add_edge("b", "t", 2)
+        self.assertEqual(g.path("t"), ["s", "b", "t"])
+        g.remove_edge("s", "b")
+        self.assertEqual(g.path("t"), ["s", "c", "t"])
