+            g.add_edge(u, v, w)
+        self.assertEqual(g.distance("t"), 2)
+        g.remove_edge("a", "t")
+        self.assertEqual(g.distance("t"), 10)
+        self.assertEqual(g.path("t"), ["s", "b", "t"])
+        self.assertEqual(g.last_recomputed, 1)  # only t changed
