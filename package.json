{
  "name": "doc-merge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three-way line-based document merge CLI (TypeScript, Node.js built-ins only)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "merge": "node dist/src/cli.js merge",
    "unmerge": "node dist/src/cli.js unmerge"
  }
}
