{
  "name": "dlks-de-0217",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Importable TypeScript webhook ingestion component with key generations, replay tolerance, delivery-id idempotency and offset-bound receipts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/src/http/server.d.ts",
      "import": "./dist/src/http/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "index.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test 'dist-test/test/**/*.test.js'"
  },
  "engines": {
    "node": ">=18"
  }
}
