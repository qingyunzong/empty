{
  "name": "inventory-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory planning CLI: integer ordering under lead time, capacity, fixed order cost and holding cost",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "plan": "node dist/src/cli.js plan",
    "replan": "node dist/src/cli.js replan",
    "verify": "node dist/src/cli.js verify"
  },
  "bin": {
    "inventory-cli": "dist/src/cli.js"
  }
}
