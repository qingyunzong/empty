{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "build",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.d.ts"
  ]
}
