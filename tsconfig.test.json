{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": false,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "tests/**/*.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
