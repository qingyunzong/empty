{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["*.ts", "src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["test", ".test-build", "dist", "node_modules"]
}
