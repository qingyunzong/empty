{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noCheck": true
  },
  "include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
